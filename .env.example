# Option A: Direct connection (use this if mongodb+srv:// fails - e.g. on networks with SRV DNS blocking)
# Replace shard hostnames, replicaSet name, username, and password with your actual values
MONGODB_URI=mongodb://<username>:<password>@<shard-00-00>.<id>.mongodb.net:27017,<shard-00-01>.<id>.mongodb.net:27017,<shard-00-02>.<id>.mongodb.net:27017/maa_park?replicaSet=<replica-set-name>&ssl=true&authSource=admin&retryWrites=true&w=majority

# Option B: Standard SRV URI (simpler — use this if your network supports SRV DNS)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.<id>.mongodb.net/maa_park?retryWrites=true&w=majority

# Port for the Express server (default: 3000)
PORT=3000

# Comma-separated list of allowed origins for CORS
# Set this to your S3 website URL in production, e.g.:
# ALLOWED_ORIGINS=https://your-bucket.s3-website.ap-south-1.amazonaws.com,https://your-cloudfront-domain.cloudfront.net
# For development/testing, '*' allows all origins:
ALLOWED_ORIGINS=*

# ─── Championship 2026 ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
CHAMPIONSHIP_ADMIN_TOKEN=change_this_to_a_long_random_secure_string
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
